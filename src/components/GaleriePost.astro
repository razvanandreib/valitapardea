---
import { Image } from "astro:assets";

import {galerie} from "../lib/galerie";
---

<section class="galerie-post-wrapper">
    {
        galerie.map((info)=> (
            <div class="galerie-post">
                <p>{info.tag}</p>
                <h3><a href={info.adresaLink}>{info.title}</a></h3>
                <Image src={info.image} alt="Ana si Edi"/>
                {
                    info.descriere.map((info)=>(
                        <p>{info}</p>
                    ))
                }
                <div class="galerie-post-socials">
                        {
                            info.sociale.map((info)=>(
                                <a href={info.linkAdresa} target="_blank" rel="noopener noreferrer"><Image src={info.image} alt={info.alt}/></a>
                            ))
                        }
                </div>   
            </div>
        ))
    }
</section>


<style lang="scss">

@use "../styles/variables" as *;

    .galerie-post-wrapper {
        @include max-width-1024;
    }

    .galerie-post {
        @include flex;
        flex-direction: column;
        gap: 1rem;
        max-width: 100%;
        width: 70rem;
        margin: 0 auto;


        >p {
            @include para-crimson;
        }

        >h3 {
            @include header-playfair;
            font-size: 3rem;
            color: $font-color;

            >a {
                color: $font-color;;
            }

            > a:visited {
                color: $font-color;
            }
        }

        > img {
            width: 100%;
            height: 40rem;
            object-fit: cover;
            object-position: 50% 20%;
        }
    }

    .galerie-post-socials {
        @include flex;
        align-items: center;
        justify-content: end;
        gap: 1rem;
        >a {
            >img {
                width: 2.5rem;
                height: 2.5rem;
            }
        }
    }
</style>