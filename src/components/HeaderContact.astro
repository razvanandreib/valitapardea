---
import { Image } from "astro:assets";

import headerContact from "../assets/first-page/header-f-page.png"
---

<section class="header-contact-wrapper">
    <div class="header-contact-container">
        <h1>„NE-AR FACE PLĂCERE SĂ AUZIM DE LA DUMNEAVOASTRA”</h1>
        <p>Permiteți-ne să vă ajutăm să creați o zi cu adevărat de neuitat</p>
        <Image src={headerContact} alt="header contact"/>
    </div>
</section>


<style lang="scss">
    @use "../styles/variables" as *;

.header-contact-container {

    @include flex-center-col;

    >h1 {
        @include header-playfair;
        font-size: 4rem;
        width: 30ch;
        text-align: center;
        font-style: italic;
        color: $font-color;
    }

    >p {
        @include para-crimson;
        font-style: italic;
        font-size: 2rem;
        margin-bottom: 4rem;
    }

    >img {
        width: 100%;
        height: 70rem;
        object-fit: cover;
        object-position: 50% 10%;
    }
}
</style>