---
import { Image } from '@astrojs/image/components';

// Dynamically import images
const images = import.meta.glob('../assets/galerie/Ana-si-Edi/galerie/*.{png,jpg,jpeg,webp}', { eager: true });

// Convert the glob import into an array of image data
const imageArray = Object.entries(images).map(([path, module]) => {
    return {
        src: module.default,
        alt: path.split('/').pop(), // Extract filename for alt text (customize as needed)
    };
});
---
   
<div id="gallery">
    {imageArray.map(({ src, alt }) => (
    <Image  src={src} alt={alt} />
))}
</div>


<style>
    img {
    padding-bottom: 10px;
  width: 100%;
  height: auto;
}
#gallery {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-around;
  width: 100%;
}
#gallery div {
  flex: 1;
}
</style>


