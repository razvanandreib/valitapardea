---
import { Image } from "astro:assets";

import testimoniale from "../assets/first-page/testimoniale.png"
import googleLogo from "../assets/logo/google-logo.png"

//import icons
import sageataDreapta from "../assets/icons/sageata-dreapta.svg"
import sageataStanga from "../assets/icons/sageata-stanga.svg"

